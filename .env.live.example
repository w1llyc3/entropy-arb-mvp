# Copy to .env.live locally. Never commit credentials. Default cannot send.
ENTROPY_LIVE_TEST=NO
# Set to the exact Git commit YOU reviewed, not a branch name.
ENTROPY_REVIEWED_COMMIT=
ENTROPY_HL_ACCOUNT=
ENTROPY_HL_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
# Optional short-lived token for authenticated read-only inspection.
LIGHTER_READ_TOKEN=
# Leave blank until integer fee units verified against account history.
LIGHTER_TRADE_FEE_SCALE=
